{
  "name": "memory-bank",
  "version": "0.2.0",
  "description": "MemoryBank CLI - Local memory service for AI agents with Terminal UI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaxsouza/MemoryBank.git"
  },
  "bin": {
    "mb-tui": "./dist/cli.js",
    "memory-bank": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "binaries/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "cd ../tui && npm run build && cp -r dist/* ../memory-bank/dist/",
    "test": "cd ../tui && npm test"
  },
  "optionalDependencies": {
    "@memory-bank/server-darwin-arm64": "0.2.0",
    "@memory-bank/server-darwin-x64": "0.2.0",
    "@memory-bank/server-linux-arm64": "0.2.0",
    "@memory-bank/server-linux-x64": "0.2.0",
    "@memory-bank/server-win32-x64": "0.2.0"
  },
  "dependencies": {
    "ink": "^4.1.0",
    "meow": "^11.0.0",
    "react": "^18.2.0"
  }
}
